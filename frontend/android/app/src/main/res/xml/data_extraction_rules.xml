<?xml version="1.0" encoding="utf-8"?>
<!--
  Ab Android 12 (API 31) steuert diese Datei, was in ein Cloud-Backup und was
  beim Geraetewechsel uebertragen wird. Beides ist hier komplett ausgeschlossen:
  Die App haelt Login-Token und Chat-Inhalte von Jugendlichen vor, die nicht im
  Google-Konto der Nutzer:innen landen sollen.

  Fuer Android 11 und aelter greift stattdessen android:allowBackup="false"
  im Manifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
