{
  "name": "konfi-points-backend",
  "version": "2.3.0",
  "description": "Backend API für das Konfi-Punkte-System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "test": "docker compose -f docker-compose.test.yml up -d --wait && npx vitest run --config tests/vitest.config.ts; EXIT=$?; docker compose -f docker-compose.test.yml down; exit $EXIT",
    "test:ci": "npx vitest run --config tests/vitest.config.ts",
    "test:watch": "npx vitest --config tests/vitest.config.ts"
  },
  "keywords": [
    "konfi",
    "points",
    "church",
    "confirmation"
  ],
  "author": "Konfi Quest",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@socket.io/postgres-adapter": "^0.5.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.1",
    "file-type": "^22.1.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "proxy-addr": "^2.0.8",
    "socket.io": "^4.8.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.3.0",
    "vitest": "^5.0.2",
    "ws": "~8.22.0"
  },
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
